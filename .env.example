# Copia este archivo como .env y cambia los valores.
# docker compose lee .env automáticamente.

# Clave con la que auth firma los JWT y con la que los demás servicios los validan.
# Debe ser larga y aleatoria (32 caracteres o más). Para generar una:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CLAVE_JWT=cambia-esta-clave-por-una-larga-y-aleatoria

# Clave para las llamadas entre servicios (/interno/...). Genérala igual que la anterior.
CLAVE_INTERNA=cambia-esta-otra-clave-tambien-larga-y-aleatoria

POSTGRES_USER=schooldesk
POSTGRES_PASSWORD=schooldesk

# Primer admin: se crea al arrancar si no existe ninguno (solo un admin puede crear usuarios).
# Usuario de 9 dígitos y contraseña de al menos 8 caracteres.
ADMIN_INICIAL_USUARIO=100500001
ADMIN_INICIAL_CONTRASENA=cambia-esta-contrasena

# Duración de la sesión de asistencia y minutos para quedar PRESENTE.
# Para la demo se pueden bajar, p. ej. MINUTOS_SESION=2 y MINUTOS_TOLERANCIA=1.
MINUTOS_SESION=10
MINUTOS_TOLERANCIA=5

# Orígenes del frontend que pueden llamar a la API (lista JSON).
ORIGENES_PERMITIDOS=["http://localhost:4200"]
